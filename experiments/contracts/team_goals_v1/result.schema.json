{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepfc:exchange:1:result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_record_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "forecast_record_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "abandoned",
            "awarded",
            "cancelled",
            "conflicting",
            "played_final",
            "postponed"
          ]
        },
        "home_goals": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "away_goals": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_kickoff_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduled_kickoff_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "captured_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "verified_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "verified_by": {
                "type": "string",
                "minLength": 1
              },
              "verification_note": {
                "type": "string",
                "minLength": 1
              },
              "verified_status": {
                "enum": [
                  "abandoned",
                  "awarded",
                  "cancelled",
                  "conflicting",
                  "played_final",
                  "postponed"
                ]
              },
              "official_identity_and_result_checked": {
                "const": true
              }
            },
            "required": [
              "source_url",
              "sha256",
              "captured_at_utc",
              "verified_at_utc",
              "verified_by",
              "verification_note",
              "verified_status",
              "official_identity_and_result_checked"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "forecast_record_id",
        "status",
        "home_goals",
        "away_goals",
        "actual_kickoff_utc",
        "scheduled_kickoff_utc",
        "completed_at_utc",
        "observed_at_utc",
        "evidence",
        "supersedes",
        "reason"
      ],
      "additionalProperties": false
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "previous_record_id",
    "recorded_at_utc",
    "outcome",
    "record_id"
  ],
  "additionalProperties": false
}
